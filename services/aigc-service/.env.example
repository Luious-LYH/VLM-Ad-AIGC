# `fake` validates API/UI contracts; `local` lazily loads staged open weights.
AIGC_BACKEND=fake
AIGC_SERVICE_NAME=metacut-aigc-service
AIGC_API_TOKEN=
AIGC_ASSET_ROOTS=/data/assets,/data/uploads
AIGC_OUTPUT_ROOT=/data/outputs
# Optional: reuse a preinstalled CUDA-enabled VLM runtime on a GPU host.
# AIGC_SERVICE_PYTHON=/public/lyh/.conda/envs/vlm/bin/python
# AIGC_PYTHONPATH=/public/lyh/.venvs/vlm-extra
AIGC_URL_ALLOWLIST=localhost,127.0.0.1,assets.example.com,*.internal.example.com
AIGC_ALLOW_DATA_URLS=true
AIGC_MAX_DATA_URL_BYTES=10485760
AIGC_FAKE_JOB_START_DELAY_MS=20
AIGC_FAKE_JOB_RUN_DELAY_MS=40

# Model labels and staged paths are recorded in every response/run manifest.
AIGC_VLM_MODEL=Qwen/Qwen3-VL-4B-Instruct
AIGC_VLM_REVISION=unpinned-dev
AIGC_VLM_PATH=/models/Qwen3-VL-4B-Instruct
AIGC_DEVICE_VLM=cuda:0
AIGC_DEVICE_IMAGE=cuda:1
AIGC_DEVICE_VIDEO=cuda:2
AIGC_IMAGE_MODEL=stabilityai/stable-diffusion-xl-base-1.0
AIGC_IMAGE_REVISION=unpinned-dev
AIGC_SDXL_PATH=/models/sdxl-base-1.0
AIGC_IP_ADAPTER_REPO=/models/IP-Adapter
AIGC_IP_ADAPTER_SUBFOLDER=sdxl_models
AIGC_IP_ADAPTER_WEIGHT_NAME=ip-adapter_sdxl.safetensors
AIGC_IP_ADAPTER_SCALE=0.65
AIGC_FLUX2_MODEL=black-forest-labs/FLUX.2-klein-4B
AIGC_FLUX2_PATH=/models/FLUX.2-klein-4B
AIGC_VIDEO_MODEL=Lightricks/LTX-Video
AIGC_VIDEO_REVISION=unpinned-dev
AIGC_LTXV_PATH=/models/LTX-Video
# Use `official` for the exact ltxv-2b-0.9.8-distilled checkpoint. The
# official runtime lives in a separate venv because it pins Transformers<4.52.
AIGC_LTX_RUNTIME=diffusers
AIGC_LTX_PYTHON=/public/lyh/projects/CV_projects/video-main/.venv-ltx/bin/python
AIGC_LTX_INFERENCE_SCRIPT=/public/lyh/projects/CV_projects/video-main/third_party/LTX-Video/inference.py
AIGC_LTX_PIPELINE_CONFIG=/public/lyh/projects/CV_projects/video-main/models/LTX-Video/ltxv-2b-0.9.8-distilled.local.yaml
AIGC_LTX_TIMEOUT_SECONDS=900
AIGC_WAN22_MODEL=Wan-AI/Wan2.2-TI2V-5B-Diffusers
AIGC_WAN22_PATH=/models/Wan2.2-TI2V-5B-Diffusers
AIGC_HY15_MODEL=hunyuanvideo-community/HunyuanVideo-1.5-Diffusers-480p_i2v_step_distilled
AIGC_HY15_PATH=/models/HunyuanVideo-1.5-Diffusers-480p_i2v_step_distilled
AIGC_HY15_GPUS=1,2
AIGC_HY15_STEPS=12
AIGC_HY15_TIMEOUT_SECONDS=2400
AIGC_HY15_PYTHON=/public/lyh/.conda/envs/vlm/bin/python
AIGC_HY15_WORKER=/public/lyh/projects/CV_projects/video-main/scripts/run-hunyuan15-worker.py
AIGC_IMAGE_STEPS=20
AIGC_VIDEO_STEPS=8
